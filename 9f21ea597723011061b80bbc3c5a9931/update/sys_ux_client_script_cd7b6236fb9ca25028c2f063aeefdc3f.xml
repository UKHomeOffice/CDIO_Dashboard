*/
function handler({api, clientStateParameter = 'elementsDeploymentFrequencyDaily'}) {
    var elementsList = [];

    // Iterate over dailyfrequency results
    var dailyResults = api.data.verticalC_headlinemetric2_daily?.output?.result || [];
    
    dailyResults.forEach((item) => {
        if (item?.value >= 12 && item?.value !== null) {
            elementsList.push(item.element.display_value);
        }
    });

    // Store the list length for use in the original script
    // var listLength = elementsList.length;
    
    api.setState(clientStateParameter, elementsList); 

}]]></script>
